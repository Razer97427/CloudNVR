CLOUD_URL=https://cloudnvr.example.com
SITE_ID=replace-with-site-id
ENROLLMENT_TOKEN=replace-with-one-time-token
AGENT_NAME=agent-maison

# Dossier local ou partage NAS déjà monté sur l'hôte.
AGENT_RECORDINGS_PATH=/mnt/videos/cloudnvr
AGENT_MIN_FREE_BYTES=2147483648
RECORDING_SEGMENT_TIME=1m

# Débit des segments envoyés à la demande vers le VPS (Mbit/s).
AGENT_UPLOAD_MBPS=8
AGENT_UPLOAD_RETRIES=4
AGENT_ALLOW_INSECURE_HTTP=false

# WebRTC direct. Rediriger 8189/UDP (et idéalement TCP) vers cet hôte.
AGENT_WEBRTC_ENABLED=true
AGENT_WEBRTC_HOSTS=198.51.100.20
AGENT_WEBRTC_PORT=8189
AGENT_WEBRTC_WORKERS=4

TZ=Indian/Reunion
