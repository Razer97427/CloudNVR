MARIADB_DATABASE=cloudnvr
MARIADB_USER=cloudnvr
MARIADB_PASSWORD=change-me
MARIADB_ROOT_PASSWORD=change-root-me
ADMIN_API_KEY=change-admin-key
# Generate with: openssl rand -base64 32
CAMERA_ENCRYPTION_KEY=REPLACE_WITH_A_BASE64_32_BYTE_KEY
PUBLIC_URL=http://localhost:8080
# Port publié sur l'hôte (le service écoute toujours sur 8080 dans Docker)
HTTP_PORT=8080

# Dossier hôte où le serveur conserve les segments MP4.
# Laisser cloud-recordings pour un volume Docker, ou mettre /mnt/videos/cloudnvr
# après avoir donné ce dossier à l'UID 10001.
CLOUD_RECORDINGS_PATH=cloud-recordings
# Durée d'un fichier; minimum 10s (exemples: 30s, 1m, 5m).
RECORDING_SEGMENT_TIME=1m
# Cache temporaire utilisé uniquement pour lire les segments demandés à l'agent.
PLAYBACK_CACHE_TTL=6h
PLAYBACK_CACHE_MAX_BYTES=10737418240
AGENT_UPLOAD_MAX_BYTES=2147483648
# Réserve minimale : les segments les plus anciens sont supprimés avant que
# le disque passe sous ce seuil. Valeur par défaut : 5 Gio.
CLOUD_MIN_FREE_BYTES=5368709120
# Fuseau utilisé pour la hiérarchie année/mois/jour/heure des fichiers.
TZ=Indian/Reunion

# Adresse RTSP publique joignable par les agents distants.
# Exemple VPS : rtsp://203.0.113.10:8554 ou rtsp://nvr.example.com:8554
MEDIA_PUBLIC_RTSP_URL=rtsp://localhost:8554
MEDIA_RTSP_PORT=8554
MEDIA_PUBLISH_USER=cloudnvr-agent
MEDIA_PUBLISH_PASSWORD=replace-with-a-long-random-password

# IP publique ou nom DNS annoncé aux navigateurs pour WebRTC.
MEDIA_WEBRTC_HOSTS=127.0.0.1
MEDIA_WEBRTC_UDP_PORT=8189
MEDIA_WEBRTC_TCP_PORT=8189

# Ces variables sont utilisées dans le .env du dossier deploy sur un site distant.
# IP publique ou DDNS de la maison annoncé comme candidat ICE par l'agent V2.
AGENT_WEBRTC_ENABLED=true
AGENT_WEBRTC_HOSTS=198.51.100.20
AGENT_WEBRTC_PORT=8189
AGENT_WEBRTC_WORKERS=4
# Réserve minimale du stockage de l'agent (2 Gio par défaut).
AGENT_MIN_FREE_BYTES=2147483648
